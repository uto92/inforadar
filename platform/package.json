{
  "name": "mobility-datahub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply mobility-datahub --local",
    "migrate:remote": "wrangler d1 migrations apply mobility-datahub --remote",
    "seed:local": "wrangler d1 execute mobility-datahub --local --file=./seeds/station_master.mock.sql",
    "seed:remote": "wrangler d1 execute mobility-datahub --remote --file=./seeds/station_master.mock.sql",
    "mock": "node tools/mock-hex.mjs"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.0"
  }
}
