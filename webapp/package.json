{
  "name": "wester-checkin-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:init": "npx -y wrangler pages project create wester-checkin --production-branch main",
    "deploy": "npm run build && npx -y wrangler pages deploy dist --project-name wester-checkin",
    "build:pages": "tsc --noEmit && vite build --base=/inforadar/ --outDir ../docs --emptyOutDir",
    "test:scan": "node e2e/barcode-scan.mjs",
    "test:sync": "node e2e/two-device-sync.mjs",
    "test:join": "node e2e/join-handoff.mjs",
    "test:salt": "node e2e/cross-event-salt.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsbarcode": "^3.12.3",
    "playwright-core": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
