{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//home/user/inforadar/**)",
      "Edit(//home/user/inforadar/**)",
      "Write(//home/user/inforadar/**)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python3 scripts/verify_structure.py)",
      "Bash(bash scripts/budget_guard.sh:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(:* rm :*)",
      "Read(//home/user/inforadar/.env)",
      "Read(//home/user/inforadar/.env.*)",
      "Read(//home/user/inforadar/**/*.key)",
      "Read(//home/user/inforadar/**/*.pem)",
      "Read(//home/user/inforadar/**/secrets/**)",
      "Read(//home/user/inforadar/**/*.secret)"
    ],
    "ask": [
      "Bash(gh:*)"
    ]
  }
}
